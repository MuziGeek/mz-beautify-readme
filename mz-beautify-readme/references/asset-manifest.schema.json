{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MuziGeek/mz-beautify-readme/schema/mz.readme-asset.v3.json",
  "title": "MZ README Asset Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "repository", "upstreamCore", "brief", "visualBrief", "publishedAsset", "sources", "validation"],
  "properties": {
    "format": {"const": "mz.readme-asset/3"},
    "status": {"enum": ["DRAFT", "GENERATION_BLOCKED", "VALIDATION_FAILED", "READY_FOR_REVIEW"]},
    "repository": {"type": "string", "minLength": 1},
    "upstreamCore": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"const": "oil-oil/beautify-github-readme"},
        "commit": {"const": "55bdb1c05414cd7a0cf911d02e55ece79777206e"}
      }
    },
    "extension": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "namespace", "version", "manifestHash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "manifestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "localization": {
      "type": "object", "additionalProperties": false,
      "required": ["primaryLocale", "outputLocales"],
      "properties": {
        "primaryLocale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "outputLocales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"}}
      }
    },
    "brief": {"$ref": "#/$defs/file"},
    "visualBrief": {"$ref": "#/$defs/file"},
    "publishedAsset": {"$ref": "#/$defs/file"},
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "validation": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["boolean", "string", "number"]}},
    "review": {"$ref": "#/$defs/file"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "READY_FOR_REVIEW"}}, "required": ["status"]}, "then": {"required": ["review"]}}],
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string"},
        "license": {"type": "string"},
        "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "viewport": {"enum": ["desktop", "mobile", "responsive"]}
      }
    }
  }
}
